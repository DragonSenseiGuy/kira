NUXT_SESSION_SECRET=your-session-secret-here

# PostgreSQL Database URL (optional - enables cloud sync)
# If not set, the app works in local-only mode using IndexedDB
DATABASE_URL=postgresql://user:password@localhost:5432/kira

# Password authentication (optional - gates the entire app)
# Set this to enable password protection for the app
NUXT_APP_PASSWORD=your-secure-password-here
