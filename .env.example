# --------------------------------------------------------------------------
# Kira - Environment Configuration
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# --------------------------------------------------------------------------

# Secret used by the server to sign session tokens and account cookies.
# Generate one with: `openssl rand -base64 32`
NUXT_SESSION_SECRET=replace-me-with-a-long-random-string

# PostgreSQL connection string (optional).
# When set, Kira enables accounts: people sign up with an email and password
# (stored as a salted scrypt hash) and their chats are saved to the database.
# When unset, Kira runs local-only from IndexedDB with no login, as before.
DATABASE_URL=postgresql://user:password@localhost:5432/kira

# Shared API key (optional). When set, signed-in users can chat without
# bringing their own key; a key set in settings still takes priority.
NUXT_OPENAI_API_KEY=
