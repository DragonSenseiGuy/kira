# @vercel/analytics and @vercel/speed-insights still declare an optional peer
# on vue-router@^4, while upstream moved to vue-router@^5 in a blanket security
# bump. The peer is optional and the two packages only observe route changes,
# so the pairing is fine in practice — but npm refuses to resolve it without
# this. Keeping it here (rather than as a CLI flag) means `npm ci`, the
# Dockerfile build and local installs all resolve identically.
legacy-peer-deps=true
